{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calendar Planner Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "status",
    "title",
    "summary",
    "assumptions",
    "questions",
    "limitations",
    "data"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "skill": {
      "const": "calendar-planner"
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "needs_input"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "assumptions": {
      "$ref": "#/$defs/strings"
    },
    "questions": {
      "$ref": "#/$defs/strings"
    },
    "limitations": {
      "$ref": "#/$defs/strings"
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/proposal"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_input"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "questions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "project_id": {
                "type": "string"
              },
              "intent": false,
              "calendar_review": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "intent"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "intent": {
                      "const": "review"
                    }
                  }
                },
                "then": {
                  "required": [
                    "calendar_review"
                  ],
                  "properties": {
                    "calendar_review": {
                      "type": "object"
                    },
                    "operations": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "intent": {
                      "const": "changes"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "project_id": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taskPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "week": {
          "type": "integer",
          "minimum": 1
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "schedule": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/schedule"
            }
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "expected_revision",
        "action",
        "patch",
        "reason"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "schedule",
            "unschedule",
            "update_task"
          ]
        },
        "patch": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "schedule"
              }
            }
          },
          "then": {
            "properties": {
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schedule"
                ],
                "properties": {
                  "schedule": {
                    "$ref": "#/$defs/schedule"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "unschedule"
              }
            }
          },
          "then": {
            "properties": {
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schedule"
                ],
                "properties": {
                  "schedule": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update_task"
              }
            }
          },
          "then": {
            "properties": {
              "patch": {
                "$ref": "#/$defs/taskPatch"
              }
            }
          }
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "operations",
        "deferred",
        "first_action"
      ],
      "properties": {
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "deferred": {
          "$ref": "#/$defs/strings"
        },
        "first_action": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "review",
            "changes"
          ]
        },
        "calendar_review": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/calendarReview"
            }
          ]
        }
      }
    },
    "calendarReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "timezone",
        "window_start",
        "window_end",
        "sources",
        "working_windows",
        "buffer_minutes",
        "available_minutes",
        "already_allocated_minutes",
        "unscheduled_effort_minutes",
        "shortfall_minutes",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "partial",
            "unavailable",
            "not_requested"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "window_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "window_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "sources": {
          "$ref": "#/$defs/strings"
        },
        "working_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weekday",
              "start",
              "end"
            ],
            "properties": {
              "weekday": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "start": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
              }
            }
          }
        },
        "buffer_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "available_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "already_allocated_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unscheduled_effort_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "shortfall_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "limitations": {
          "$ref": "#/$defs/strings"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "checked"
              }
            }
          },
          "then": {
            "properties": {
              "checked_at": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "window_start": {
                "type": "string"
              },
              "window_end": {
                "type": "string"
              },
              "sources": {
                "minItems": 1
              },
              "working_windows": {
                "minItems": 1
              },
              "buffer_minutes": {
                "type": "integer"
              },
              "available_minutes": {
                "type": "integer"
              },
              "already_allocated_minutes": {
                "type": "integer"
              },
              "unscheduled_effort_minutes": {
                "type": "integer"
              },
              "shortfall_minutes": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "not_requested"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "available_minutes": {
                "type": "null"
              },
              "shortfall_minutes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
